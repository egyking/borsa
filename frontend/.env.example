# Frontend reads the static snapshot.json by default (no backend needed).
# Leave VITE_API_URL empty for production static hosting.
# Set it only if you run the optional FastAPI backend for live/on-demand data.
VITE_API_URL=
# Optional: override the snapshot location (defaults to /snapshot.json).
# VITE_SNAPSHOT_URL=/snapshot.json

# Firebase (optional — only needed if you re-enable Google login).
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
